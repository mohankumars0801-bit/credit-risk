# ============================================================
# JACCS Credit Scoring System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# 
# On Windows PowerShell, set these before running the app:
#   $env:JACCS_DEFAULT_ADMIN_PASSWORD = "your_password"
#   $env:SQL_SERVER = "your_server\SQLEXPRESS"
# ============================================================


# ── Authentication ───────────────────────────────────────────────────────────
# The password assigned to admin@example.com on the very first run.
# If not set, a random secure password is generated and printed to the console.
JACCS_DEFAULT_ADMIN_PASSWORD=change_me_on_first_run_minimum_8_chars


# ── Database Connection ───────────────────────────────────────────────────────
# SQL Server instance hostname / address.
# This overrides the value in src/data/database/db_config.json.
# Examples:
#   SQL_SERVER=MYSERVER\SQLEXPRESS
#   SQL_SERVER=192.168.1.100
SQL_SERVER=


# ── Logging ───────────────────────────────────────────────────────────────────
# Log verbosity. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Logs are written to ~/.jaccs_credit_app/logs/app.log
JACCS_LOG_LEVEL=INFO


# ── Model Cache ───────────────────────────────────────────────────────────────
# Directory where the trained model .joblib file is stored.
# Defaults to src/backend/models relative to the project root.
# JACCS_MODEL_CACHE_DIR=src/backend/models


# ── Feature Flags (Advanced) ──────────────────────────────────────────────────
# Set to "1" to enable SHAP explanation for every batch prediction (slower).
# JACCS_SHAP_ALWAYS=0

# Set to "1" to skip DB connection on startup and always use local CSV fallback.
# JACCS_OFFLINE_MODE=0

